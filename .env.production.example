# Production Environment Configuration
# Copy this file to .env.production and update with actual production values

# Application
NODE_ENV=production
APP_NAME=RateMe
APP_VERSION=1.0.0
PORT=3000
NEXTAUTH_URL=https://ratemy.app

# Database
DATABASE_URL=postgresql://prod_user:prod_password@prod-db:5432/ratemy_production

# Authentication
NEXTAUTH_SECRET=production-secret-32-characters-long-secure-random-value

# Redis (Required for production)
REDIS_URL=redis://prod-redis:6379
REDIS_PASSWORD=production_redis_password

# External Services (Production keys)
YOUTUBE_API_KEY=production_youtube_api_key
VIMEO_CLIENT_ID=production_vimeo_client_id
VIMEO_CLIENT_SECRET=production_vimeo_client_secret

# Logging
LOG_LEVEL=warn

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# Monitoring (Production)
SENTRY_DSN=https://production_sentry_dsn@sentry.io/production_project_id
NEW_RELIC_LICENSE_KEY=production_new_relic_license_key
NEW_RELIC_APP_NAME=RateMe-Production

# Email (Production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=production-smtp-user
SMTP_PASS=production-smtp-password
FROM_EMAIL=noreply@ratemy.app

# File Storage (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=production_aws_access_key
AWS_SECRET_ACCESS_KEY=production_aws_secret_key
AWS_S3_BUCKET=ratemy-production-uploads

# CDN (Production)
CLOUDFRONT_DOMAIN=cdn.ratemy.app

# Feature Flags (Production)
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_LOGS=false

# SSL/TLS (Production)
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Scaling
MAX_CONNECTIONS=100
WORKER_PROCESSES=4

# Security Headers
CSP_REPORT_URI=https://ratemy.report-uri.com/r/d/csp/enforce
HPKP_PINS=pin-sha256="base64+primary="; pin-sha256="base64+backup="