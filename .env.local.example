# Local Database Configuration for Migration
# Copy this to .env.local and update with your Docker PostgreSQL settings

LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/ratemy_dev

# If your Docker setup is different, update the connection string:
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ratemy
# LOCAL_DATABASE_URL=postgresql://ratemy_user:ratemy_password@localhost:5432/ratemy_dev