# Staging Environment Configuration
# Copy this file to .env.staging and update with actual staging values

# Application
NODE_ENV=production
APP_NAME=RateMe-Staging
APP_VERSION=1.0.0
PORT=3000
NEXTAUTH_URL=https://staging.ratemy.app

# Database
DATABASE_URL=postgresql://staging_user:staging_password@staging-db:5432/ratemy_staging

# Authentication
NEXTAUTH_SECRET=staging-secret-32-characters-long-change-this-value

# Redis (Optional for staging)
REDIS_URL=redis://staging-redis:6379
REDIS_PASSWORD=staging_redis_password

# External Services (Staging/Development keys)
YOUTUBE_API_KEY=staging_youtube_api_key
VIMEO_CLIENT_ID=staging_vimeo_client_id
VIMEO_CLIENT_SECRET=staging_vimeo_client_secret

# Logging
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring (Staging)
SENTRY_DSN=https://staging_sentry_dsn@sentry.io/staging_project_id
NEW_RELIC_LICENSE_KEY=staging_new_relic_license_key
NEW_RELIC_APP_NAME=RateMe-Staging

# Email (Staging)
SMTP_HOST=staging-smtp.example.com
SMTP_PORT=587
SMTP_USER=staging-smtp-user
SMTP_PASS=staging-smtp-password
FROM_EMAIL=noreply-staging@ratemy.app

# File Storage (Staging)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=staging_aws_access_key
AWS_SECRET_ACCESS_KEY=staging_aws_secret_key
AWS_S3_BUCKET=ratemy-staging-uploads

# CDN (Staging)
CLOUDFRONT_DOMAIN=staging-cdn.ratemy.app

# Feature Flags (Staging)
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_LOGS=false

# SSL/TLS (Staging)
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000