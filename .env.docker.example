# ===========================================
# Docker Environment Configuration
# ===========================================
# Copy this file to .env.docker and fill in the values
# NEVER commit .env.docker to version control!

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
POSTGRES_DB=ratemy_db
POSTGRES_USER=ratemy_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST_AUTH_METHOD=md5

# ===========================================
# Application Configuration
# ===========================================
DATABASE_URL=postgresql://ratemy_user:your_secure_postgres_password_here@postgres:5432/ratemy_db

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secure_nextauth_secret_minimum_32_characters_long

# Development URLs (optional overrides)
DATABASE_URL_DEV=postgresql://ratemy_user:your_secure_postgres_password_here@postgres:5432/ratemy_db
NEXTAUTH_URL_DEV=http://localhost:3001

# Application Settings
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# ===========================================
# Security Notes
# ===========================================
# 1. Generate secure passwords with: openssl rand -base64 32
# 2. NEXTAUTH_SECRET should be at least 32 characters
# 3. Use different secrets for development, staging, and production
# 4. Never use these example values in production!

# ===========================================
# Production Environment Examples
# ===========================================
# For production, use environment-specific secrets:
# POSTGRES_PASSWORD=<use AWS Secrets Manager or secure secret store>
# NEXTAUTH_SECRET=<use AWS Secrets Manager or secure secret store>
# DATABASE_URL=<use managed database connection string>
# NEXTAUTH_URL=https://yourdomain.com